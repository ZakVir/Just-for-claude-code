# secrets and local state — never commit
.env
.env.*
*.pem
*.key

# data and vendored code (re-creatable)
vendor/
data/
*.parquet
*.sqlite
*.db
logs/
reports/*.html

__pycache__/
.venv/
KILL

# experiment run logs (results live in the JSON/MD outputs)
experiments/*/results/*.log
# live-loop outputs while the loop is running (force-added when it finishes)
experiments/model-shootout/results/live_loop.md
experiments/model-shootout/results/live_loop.jsonl
experiments/model-shootout/results/backtest_ckpt.json
