{
  "name": "flow-studio-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP server that drives the Google Flow web UI via Playwright, using an isolated logged-in Chrome profile.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "login": "npm run build && node dist/scripts/login.js",
    "status": "npm run build && node dist/scripts/check-status.js",
    "doctor": "npm run build && node dist/scripts/doctor.js",
    "test": "vitest run",
    "start": "npm run build && node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
