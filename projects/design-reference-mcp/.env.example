# Copy to .env and fill in. All keys are optional for v0 (repo + scraper engines).
# Sources whose key is missing degrade gracefully and report why.

# No Behance key here on purpose — Adobe deprecated the public API in 2018
# (no new keys issued, permanent) and behance.net/robots.txt separately
# disallows anthropic-ai/Claude-Web/ClaudeBot sitewide. Behance is a gated
# source; see README.md's "A note on Behance".

# Google Fonts API (api engine). https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_KEY=

# SearXNG (wrapper engine) — base URL of a self-hosted instance with
# `search.formats: [json]` enabled in settings.yml. No vendor account or key
# needed; this is the only required setting for the wrapper engine.
# Install: https://docs.searxng.org/admin/installation.html
SEARXNG_URL=

# Optional: only needed if your instance sits behind an auth proxy expecting
# a bearer token.
SEARXNG_KEY=
