# Copy to .env and fill in. All keys are optional for v0 (repo + scraper engines).
# Sources whose key is missing degrade gracefully and report why.

# Behance API (api engine). Register: https://www.behance.net/dev
# Rate cap is 150 req/hr/IP; the limiter stays under at 120/hr.
BEHANCE_API_KEY=

# Google Fonts API (api engine). https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_KEY=

# parse.bot key for the Cosmos wrapper (wrapper engine). Free key at https://parse.bot
# Third-party; may break — treated as optional.
PARSE_BOT_KEY=

# Optional: parse.bot scraper id for the Cosmos endpoint. Defaults to "cosmos".
# PARSE_BOT_COSMOS_ID=cosmos
