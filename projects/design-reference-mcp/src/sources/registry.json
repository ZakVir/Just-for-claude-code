{
  "version": 1,
  "note": "Source registry for design-reference-mcp. Each entry declares which engine handles it and what it is good for. Routing in engines/*.ts and index.ts reads from here.",
  "sources": [
    {
      "id": "behance",
      "name": "Behance",
      "engine": "api",
      "url": "https://www.behance.net",
      "good_for": "Curated design projects, case studies, branding, UI concepts",
      "endpoint": "GET https://api.behance.net/v2/projects?q={query}&api_key={KEY}",
      "detail_endpoint": "GET https://api.behance.net/v2/projects/{id} -> modules[].src",
      "register": "https://www.behance.net/dev",
      "rate_cap_per_hr": 150,
      "requires_key": "BEHANCE_API_KEY",
      "license": "editorial"
    },
    {
      "id": "google-fonts",
      "name": "Google Fonts",
      "engine": "api",
      "url": "https://fonts.google.com",
      "good_for": "Font families, weights, and pairing hydration",
      "endpoint": "GET https://www.googleapis.com/webfonts/v1/webfonts?key={KEY}",
      "requires_key": "GOOGLE_FONTS_KEY",
      "license": "OFL / Apache (per family)"
    },
    {
      "id": "cosmos",
      "name": "Cosmos",
      "engine": "wrapper",
      "url": "https://www.cosmos.so",
      "good_for": "Visual mood/inspiration search across curated boards",
      "endpoint": "POST https://api.parse.bot/scraper/{id}/search_elements {query,color,content_type}",
      "register": "https://parse.bot",
      "requires_key": "PARSE_BOT_KEY",
      "optional": true,
      "note": "Third-party wrapper; may break — treat as optional.",
      "license": "editorial"
    },

